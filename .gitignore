# See http://help.github.com/ignore-files/ for more about ignoring files.

# project files
.env

# compiled output
/dist
/tmp
/out-tsc
/*.tsbuildinfo

# dependencies
/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude Code: local state (never versioned).
# .claude/settings.json and .claude/hooks/ ARE versioned (#5).
/.claude/worktrees/
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# codegen and tooling output
/.codegen-tmp/
/scripts/__pycache__/
/coverage/
